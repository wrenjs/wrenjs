{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"paths": {
			"#/*": ["./src/*"],
			"#shared/*": ["../../_shared/*"]
		},
		"skipLibCheck": true,
		"strict": true,
		"target": "esnext",
		"types": ["vite/client", "@wrenjs/core/types"],
		"verbatimModuleSyntax": true
	},
	"include": ["src"]
}
