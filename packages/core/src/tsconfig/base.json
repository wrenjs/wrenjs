{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  },
  "exclude": ["${configDir}/dist", "${configDir}/node_modules"],
  "files": ["../types.d.ts"],
  "include": ["${configDir}/**/*"]
}
