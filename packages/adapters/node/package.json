{
  "name": "@wrenjs/adapter-node",
  "version": "0.1.0",
  "description": "Node adapter for wrenjs",
  "keywords": [
    "adapter",
    "integration",
    "node",
    "server",
    "vite",
    "wren",
    "wrenjs"
  ],
  "homepage": "https://wrenjs.org",
  "bugs": {
    "url": "https://github.com/wrenjs/wrenjs/issues",
    "email": "maintainers@wrenjs.org"
  },
  "license": "MIT",
  "author": {
    "name": "wrenjs Authors",
    "email": "maintainers@wrenjs.org",
    "url": "https://github.com/wrenjs/wrenjs/AUTHORS.md"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wrenjs/wrenjs.git",
    "directory": "packages/adapters/node"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/wrenjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./entry/server": "./dist/entry/server.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build",
    "publish": "vp pm publish",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plus": "catalog:",
    "wrenjs": "workspace:*"
  },
  "peerDependencies": {
    "vite": "*",
    "wrenjs": "*"
  }
}
