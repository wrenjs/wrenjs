{
	"name": "@wrenjs/adapter-node",
	"version": "0.36.0",
	"description": "Node adapter for wrenjs",
	"keywords": [
		"@wrenjs/core",
		"adapter",
		"integration",
		"node",
		"server",
		"vite",
		"wren"
	],
	"homepage": "https://wrenjs.org",
	"bugs": {
		"url": "https://github.com/wrenjs/wrenjs/issues",
		"email": "maintainers@wrenjs.org"
	},
	"license": "MIT",
	"author": {
		"name": "wrenjs Authors",
		"email": "maintainers@wrenjs.org",
		"url": "https://github.com/wrenjs/wrenjs/AUTHORS.md"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/wrenjs/wrenjs.git",
		"directory": "packages/adapters/node"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/wrenjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"exports": {
		".": "./dist/index.mjs",
		"./entry/server": "./dist/entry/server.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"check": "vp check",
		"dev": "vp pack --watch",
		"publish": "vp pm publish --publish-branch trunk",
		"prepublishOnly": "vp run build",
		"test": "vp test"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@wrenjs/core": "workspace:*",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"@wrenjs/core": "*",
		"vite": "catalog:runtime"
	}
}
