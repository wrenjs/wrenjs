{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "assets": {
    "directory": "./dist/client",
  },
  "compatibility_date": "2026-10-12",
  "name": "wrenjs",
  "placement": {
    "mode": "smart",
  },
  "preview_urls": false,
  "routes": [
    {
      "custom_domain": true,
      "enabled": true,
      "pattern": "wrenjs.org",
      "previews_enabled": false,
    },
  ],
  "workers_dev": false,
}
