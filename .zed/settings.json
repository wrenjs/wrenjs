{
	"code_actions_on_format": {
		"source.fixAll.oxc": true
	},
	"ensure_final_newline_on_save": true,
	"format_on_save": "modifications_if_available",
	"formatter": [
		{
			"language_server": {
				"name": "oxfmt"
			}
		}
	],
	"hard_tabs": true,
	"language_servers": ["!eslint", "!tailwindcss-language-server", "!oxfmt", "!oxlint"],
	"languages": {
		"CSS": {
			"language_servers": ["!tailwindcss-language-server", "..."]
		},
		"JSON": {
			"language_servers": ["oxfmt", "oxlint", "..."]
		},
		"JSONC": {
			"language_servers": ["oxfmt", "oxlint", "..."]
		},
		"JavaScript": {
			"language_servers": ["!eslint", "!tailwindcss-language-server", "oxfmt", "oxlint", "..."]
		},
		"TSX": {
			"language_servers": ["!eslint", "!tailwindcss-language-server", "oxfmt", "oxlint", "..."]
		},
		"TypeScript": {
			"language_servers": ["!eslint", "!tailwindcss-language-server", "oxfmt", "oxlint", "..."]
		}
	},
	"lsp": {
		"oxlint": {
			"initialization_options": {
				"settings": {
					"run": "onType",
					"disableNestedConfig": false,
					"fixKind": "dangerous_fix_or_suggestion",
					"unusedDisableDirectives": "deny"
				}
			}
		},
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"fmt.configPath": null,
					"run": "onSave"
				}
			}
		}
	},
	"line_ending": "prefer_lf",
	"prettier": {
		"allowed": false
	}
}
